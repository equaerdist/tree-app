{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Properties": {
      "Application": "TreeApi"
    }
  },
  "DatabaseConfiguration": {
    "ConnectionString": "Host=localhost;Port=6543;Database=tree_db;Username=postgres;Password=postgres"
  },
  "AllowedHosts": "*"
}
